# Redis ElastiCache replication group for the Agri-Fi backend.
# Provides a multi-AZ Redis 7 cluster with TLS in-transit and at-rest encryption.
# The AUTH token is generated by Terraform and stored in AWS Secrets Manager.

# ---------------------------------------------------------------------------
# Random AUTH token
# ---------------------------------------------------------------------------

resource "random_password" "redis_auth_token" {
  length           = 32
  special          = true
  # ElastiCache AUTH tokens may not contain @, /, or " characters.
  override_special = "!#$%&*()-_=+[]{}<>:?"
}

# ---------------------------------------------------------------------------
# Subnet group (reuse the same private subnets as RDS)
# ---------------------------------------------------------------------------

resource "aws_elasticache_subnet_group" "redis" {
  name       = "${var.project_name}-${var.environment}-redis"
  subnet_ids = var.db_subnet_ids

  tags = {
    Name    = "${var.project_name}-${var.environment}-redis-subnet-group"
    Project = "agri-fi"
  }
}

# ---------------------------------------------------------------------------
# Security group — allow inbound 6379 from backend subnets only
# ---------------------------------------------------------------------------

resource "aws_security_group" "redis" {
  name        = "${var.project_name}-${var.environment}-redis-sg"
  description = "Allow Redis access from the backend subnet only"
  vpc_id      = var.vpc_id

  ingress {
    description = "Redis from backend subnets"
    from_port   = 6379
    to_port     = 6379
    protocol    = "tcp"
    cidr_blocks = var.backend_subnet_cidrs
  }

  egress {
    description = "Allow all outbound"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name    = "${var.project_name}-${var.environment}-redis-sg"
    Project = "agri-fi"
  }
}

# ---------------------------------------------------------------------------
# ElastiCache replication group (primary + replicas, multi-AZ)
# ---------------------------------------------------------------------------

resource "aws_elasticache_replication_group" "redis" {
  replication_group_id = "${var.project_name}-${var.environment}-redis"
  description          = "Agri-Fi Redis cluster (${var.environment})"

  engine               = "redis"
  engine_version       = var.redis_engine_version
  node_type            = var.redis_node_type
  port                 = 6379

  # num_cache_clusters = replicas + 1 (primary)
  num_cache_clusters = var.redis_num_replicas + 1

  automatic_failover_enabled = true
  multi_az_enabled           = true

  # Encryption
  transit_encryption_enabled = true
  at_rest_encryption_enabled = true
  auth_token                 = random_password.redis_auth_token.result

  subnet_group_name  = aws_elasticache_subnet_group.redis.name
  security_group_ids = [aws_security_group.redis.id]

  # Maintenance / snapshots
  snapshot_retention_limit = 1
  snapshot_window          = "03:00-04:00"
  maintenance_window       = "sun:04:30-sun:05:30"

  apply_immediately = false

  tags = {
    Name        = "${var.project_name}-${var.environment}-redis"
    Project     = "agri-fi"
    Environment = var.environment
    ManagedBy   = "terraform"
  }
}

# ---------------------------------------------------------------------------
# Secrets Manager — store auth token and TLS connection URL
# ---------------------------------------------------------------------------

resource "aws_secretsmanager_secret" "redis_credentials" {
  name = "${var.project_name}/${var.environment}/redis-credentials"

  recovery_window_in_days = 7

  tags = {
    Name        = "${var.project_name}-${var.environment}-redis-secret"
    Project     = "agri-fi"
    Environment = var.environment
    ManagedBy   = "terraform"
  }
}

resource "aws_secretsmanager_secret_version" "redis_credentials" {
  secret_id = aws_secretsmanager_secret.redis_credentials.id

  secret_string = jsonencode({
    redis_auth_token = random_password.redis_auth_token.result
    redis_url        = "rediss://:${random_password.redis_auth_token.result}@${aws_elasticache_replication_group.redis.primary_endpoint_address}:6379"
  })
}
