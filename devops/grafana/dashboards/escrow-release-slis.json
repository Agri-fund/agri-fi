    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "USD payout volume by recipient type (platform fee + investor + farmer).",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
