{
  "type": "s3",
  "settings": {
    "bucket": "agri-fi-elasticsearch-backups",
    "base_path": "logs/snapshots",
    "region": "us-east-1",
    "compress": true,
    "chunk_size": "100mb",
    "server_side_encryption": true,
    "buffer_size": "256mb",
    "canned_acl": "private",
    "storage_class": "STANDARD_IA",
    "max_snapshot_bytes_per_sec": "500mb",
    "max_restore_bytes_per_sec": "500mb"
  }
}
