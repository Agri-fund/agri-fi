    "file-type": "^16.5.4",
    "helmet": "^8.2.0",
    "nestjs-cls": "^6.2.0",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^8.0.6",
    "openpgp": "^4.10.11",
    "otplib": "^12.0.1",
    "passport": "^0.6.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.3",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "sharp": "^0.35.2",
