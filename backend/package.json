{
  "name": "agric-onchain-backend",
  "version": "0.1.0",
  "description": "Agric-onchain Finance Platform - NestJS Backend",
  "scripts": {
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:cov": "jest --config jest.config.js --coverage",
    "test:e2e": "jest --config jest.e2e.config.js",
    "test:e2e:watch": "jest --config jest.e2e.config.js --watch",
    "test:all": "npm run test && npm run test:e2e",
    "build": "nest build",
    "build:docs": "npm run build && node generate-openapi.js",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node -r dotenv-vault/config dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "npm run typeorm migration:run -- -d src/database/data-source.ts",
    "migration:revert": "npm run typeorm migration:revert -- -d src/database/data-source.ts",
    "dotenv-vault:build": "dotenv-vault build",
    "dotenv-vault:push": "dotenv-vault push",
    "dotenv-vault:pull": "dotenv-vault pull",
    "dotenv-vault:keys": "dotenv-vault keys",
    "dotenv-vault:open": "dotenv-vault open",
    "db:seed": "ts-node scripts/seed.ts",
    "db:seed:batch": "ts-node -r tsconfig-paths/register scripts/batch-seed.ts",
    "queue:retry-dlq": "ts-node scripts/retry-dlq.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@as-integrations/express5": "^1.0.0",
    "@nestjs/apollo": "^12.2.0",
    "@nestjs/graphql": "^12.2.0",
    "dataloader": "^2.2.2",
    "graphql": "^16.9.0",
    "graphql-depth-limit": "^1.1.0",
    "graphql-subscriptions": "^2.0.0",
    "@aws-sdk/client-kms": "^3.1075.0",
    "@aws-sdk/client-s3": "^3.1016.0",
    "@aws-sdk/client-secrets-manager": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1016.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.2.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/platform-socket.io": "^11.2.3",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
