    "@nestjs/websockets": "^11.2.3",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^10.55.0",
    "@stellar/stellar-sdk": "^13.3.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/zxcvbn": "^4.4.4",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.3",
    "argon2": "^0.31.2",
    "axios": "^1.6.0",
    "bcrypt": "^5.1.0",
    "bignumber.js": "^11.1.4",
    "cache-manager": "^6.4.3",
