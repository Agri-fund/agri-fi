# Test Environment Configuration
# Copy this file to .env.test and update values for your local test environment
# This file is used by Jest E2E tests via tests/e2e/setup.ts

# Database Configuration for Testing
# Use a separate test database to avoid data loss during testing
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=agric_onchain_test

# JWT Configuration
JWT_SECRET=test-secret-key-do-not-use-in-production
JWT_EXPIRES_IN=7d

# RabbitMQ Configuration (optional - tests can run without it)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Stellar Configuration (Testnet for E2E tests)
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Use a funded testnet account for E2E tests (optional)
STELLAR_PLATFORM_SECRET=
STELLAR_PLATFORM_WALLET=

# Soroban Event Indexing (optional for tests)
SOROBAN_EVENT_INDEXING_ENABLED=false  # Disable for unit tests, enable for E2E
SOROBAN_EVENT_POLLING_INTERVAL_MS=10000
FARM_CAMPAIGN_CONTRACT=C...
PROJECT_FACTORY_CONTRACT=C...
REVENUE_DISTRIBUTOR_CONTRACT=C...
MARKETPLACE_SETTLEMENT_CONTRACT=C...

# Encryption Configuration (use test key)
ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Server Configuration
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging Configuration (reduce noise in tests)
NODE_ENV=test
LOG_LEVEL=error
LOG_PRETTY=false

# KYC Configuration
KYC_AUTO_APPROVE=true

# Storage Configuration (optional for E2E tests)
AWS_REGION=us-east-1
AWS_S3_BUCKET=test-bucket

# Notifications (disable for tests)
NOTIFICATIONS_ENABLED=false
