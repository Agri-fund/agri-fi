<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Investment Confirmed</title>
</head>
<body style="margin:0;padding:0;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6f8;padding:24px 0;">
    <tr><td align="center">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:8px;padding:32px;">
        <tr><td style="font-size:20px;font-weight:bold;color:#166534;padding-bottom:16px;">Agri-Fi</td></tr>
        <tr><td style="font-size:18px;font-weight:bold;padding-bottom:12px;">Investment Confirmed</td></tr>
        <tr><td style="font-size:14px;line-height:22px;">
<p style="margin:0 0 12px 0;">Thank you for investing in <strong>{{dealName}}</strong>.</p>
<p style="margin:0 0 12px 0;">Amount invested: <strong>${{amount}}</strong></p>
<p style="margin:0 0 12px 0;">Tokens purchased: <strong>{{tokenAmount}}</strong></p>
<p style="margin:0 0 12px 0;">On-chain transaction: <code>{{txId}}</code></p>
{{#if receiptUrl}}
<p style="margin:0 0 12px 0;">
  Download your payment receipt:
  <a href="{{receiptUrl}}" style="color:#166534;font-weight:bold;">Download PDF Receipt</a>
</p>
{{/if}}
        </td></tr>
        <tr><td style="font-size:12px;color:#6b7280;padding-top:24px;border-top:1px solid #e5e7eb;">
          Agri-Fi &middot; Secure agricultural trade financing
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
